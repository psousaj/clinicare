{
  "name": "@clinicare/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "dev:debug": "bun --inspect=localhost:6499/clinicare --hot src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@clinicare/db": "workspace:*",
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "@hono/node-server": "latest",
    "hono": "latest",
    "mongoose": "latest"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "mongodb-memory-server": "latest",
    "typescript": "latest"
  }
}
