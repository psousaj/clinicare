# Produção (docker-compose.yml): todas obrigatórias, sem defaults de teste.
# Gere valores locais com: openssl rand -base64 32
# Banco: localhost para Bun no host; o dev-compose usa o hostname interno `postgres`.
DATABASE_URL=postgresql://clinicare:clinicare@localhost:5432/clinicare
DB_SCHEMA=clinicare
# Criptografia e HMAC (obrigatórias)
DATA_ENCRYPTION_KEY=
SEARCH_HMAC_KEY=
UPLOAD_SIGNING_KEY=
# Autenticação administrativa (obrigatórias em produção)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Storage Cloudflare R2 (obrigatórias em produção; objetos privados via URLs temporárias do backend)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clinicare-dev
# Conversão DOCX->PDF via ONLYOFFICE Document Server (opcional; vazio = materialização DOCX desabilitada)
ONLYOFFICE_CONVERTER_URL=
# Porta publicada do app em produção (opcional, padrão 3000)
APP_PORT=3000
# Desenvolvimento (dev-compose.yml): somente para o emulador S3 local (ministack).
# NUNCA defina S3_ENDPOINT em produção — ausente, o SDK usa o endpoint real do R2.
S3_ENDPOINT=http://localhost:4566

# Porta do servidor de dev do Vite
VITE_PORT=5173
# Alvo do proxy de /api em dev (a API do apps/api)
VITE_API_PROXY_TARGET=http://localhost:3000
