# Exemplo para desenvolvimento local. Não reutilize valores de teste em produção.
# Produção: use PostgreSQL externo, URLs públicas HTTPS e segredos próprios;
# não configure MINISTACK_* no ambiente produtivo.
# Gere valores locais com: openssl rand -base64 32
# Banco: localhost para Bun no host; o dev-compose usa o hostname interno `postgres`.
DATABASE_URL=postgresql://clinicare:clinicare@localhost:5432/clinicare
# Criptografia e HMAC (obrigatórias)
DATA_ENCRYPTION_KEY=
SEARCH_HMAC_KEY=
UPLOAD_SIGNING_KEY=
# Autenticação pessoal (segredo e URLs obrigatórios em produção)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BETTER_AUTH_SECRET=
# Entrega real de confirmação de conta (obrigatório para cadastro público).
RESEND_API_KEY=
EMAIL_FROM=
# Cadastro: conta pessoal → confirmação de e-mail → cadastro da clínica no Free.
# O startup não cria nem renomeia contas/clínicas por bootstrap.
# Storage Cloudflare R2 (objetos privados via URLs temporárias do backend).
# O endpoint é derivado do account ID: https://<account-id>.r2.cloudflarestorage.com
# Use o par de credenciais S3 do R2, não um token genérico da API Cloudflare.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Desenvolvimento local: defina MINISTACK_ENDPOINT para usar o emulador, independente das envs R2 acima.
MINISTACK_ENDPOINT=http://localhost:4566
MINISTACK_ACCESS_KEY_ID=test
MINISTACK_SECRET_ACCESS_KEY=test
MINISTACK_BUCKET=clinicare-dev
MINISTACK_TEST_BUCKET=clinicare-test
# Conversão DOCX->PDF via LibreOffice headless sob demanda (`soffice`,
# embutido na imagem de runtime; nenhum serviço externo).
# WEB_PORT: Vite no desenvolvimento (5173); em produção, porta publicada
# pelo docker-compose (ajuste para 3000 ou a porta desejada).
# API_PORT: listener da API (e porta interna do container).
WEB_PORT=5173
API_PORT=3000
# Opcional: override apenas para uma API remota ou containerizada;
# a API local usa API_PORT automaticamente.
# VITE_API_PROXY_TARGET=http://localhost:3000
# Testes de integração da API: copie as chaves deste arquivo para um `.env.test` (ignorado pelo git)
# usando um database PostgreSQL descartável e storage apontando para o MiniStack
# (MINISTACK_ENDPOINT/ACCESS_KEY_ID/SECRET_ACCESS_KEY/BUCKET). Crie o bucket no emulador e rode:
#   bun run test:api:env
# Smoke de confirmação real: use um banco local dedicado terminado em
# `_email_test`, credenciais Resend e uma caixa de entrada isolada:
#   DATABASE_URL=..._email_test EMAIL_TEST_RECIPIENT=... bun run --cwd apps/api test:email-integration
