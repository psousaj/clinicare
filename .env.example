# PostgreSQL (obrigatório para a API e migrations)
DATABASE_URL=postgresql://clinicare:clinicare@localhost:5432/clinicare
# Generate local-only values with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
SEARCH_HMAC_KEY=
UPLOAD_SIGNING_KEY=
# R2 é opcional, necessário somente para uploads
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clinicare-dev
# Para o emulador local do Compose/dev-compose
S3_ENDPOINT=http://localhost:4566
