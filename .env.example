# Produção (docker-compose.yml): todas obrigatórias, sem defaults de teste.
# Gere valores locais com: openssl rand -base64 32
# Banco: localhost para Bun no host; o dev-compose usa o hostname interno `postgres`.
DATABASE_URL=postgresql://clinicare:clinicare@localhost:5432/clinicare
DB_SCHEMA=clinicare
# Criptografia e HMAC (obrigatórias)
DATA_ENCRYPTION_KEY=
SEARCH_HMAC_KEY=
UPLOAD_SIGNING_KEY=
# Autenticação administrativa (obrigatórias em produção)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BETTER_AUTH_SECRET=
# Conta inicial da clínica (opcional): provisionada uma vez no primeiro startup
# quando as quatro chaves estão preenchidas; a senha existente nunca é
# sobrescrita pelo seed. Nomes mudam depois em Configurações → Clínica e
# conta, e o boot nunca os reverte. Sem estas chaves, provisione com:
#   bun run provision-tenant --clinic-name "Nome" --admin-name "Nome" --admin-email email --admin-password senha
BOOTSTRAP_CLINIC_NAME=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Storage Cloudflare R2 (objetos privados via URLs temporárias do backend).
# Pode usar a URL do endpoint exibida pela Cloudflare, inclusive com /<bucket> no final.
R2_ENDPOINT_URL=
# Alternativa a R2_ENDPOINT_URL: informe somente o account ID.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Desenvolvimento local: defina MINISTACK_ENDPOINT para usar o emulador, independente das envs R2 acima.
MINISTACK_ENDPOINT=http://localhost:4566
MINISTACK_ACCESS_KEY_ID=test
MINISTACK_SECRET_ACCESS_KEY=test
MINISTACK_BUCKET=clinicare-dev
# Conversão DOCX->PDF via LibreOffice headless sob demanda (`soffice`,
# embutido na imagem de runtime; nenhum serviço externo).
# Porta publicada do app em produção (opcional, padrão 3000).
# APP_PORT é a canônica; API_PORT é aceita como alias legado.
# Se mudar, ajuste BETTER_AUTH_URL e VITE_API_PROXY_TARGET junto.
APP_PORT=3000
# Alias legado de APP_PORT (mantido p/ .envs antigos que usam API_PORT).
# API_PORT=3000
# Porta do servidor de dev do Vite
VITE_PORT=5173
# Alvo do proxy de /api em dev (a API do apps/api)
VITE_API_PROXY_TARGET=http://localhost:3000

# Testes de integração da API: copie as chaves deste arquivo para um `.env.test` (ignorado pelo git)
# com DB_SCHEMA=clinicare_test e o storage apontando para o MiniStack
# (MINISTACK_ENDPOINT/ACCESS_KEY_ID/SECRET_ACCESS_KEY/BUCKET). Crie o bucket no emulador e rode:
#   bun run test:api:env
