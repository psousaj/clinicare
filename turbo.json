{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "DB_SCHEMA",
        "DATA_ENCRYPTION_KEY",
        "SEARCH_HMAC_KEY",
        "UPLOAD_SIGNING_KEY",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "BETTER_AUTH_SECRET",
        "S3_ENDPOINT",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET",
        "CLOUDFLARE_ACCOUNT_ID",
        "ONLYOFFICE_CONVERTER_URL",
        "BOOTSTRAP_CLINIC_NAME",
        "BOOTSTRAP_ADMIN_NAME",
        "BOOTSTRAP_ADMIN_EMAIL",
        "BOOTSTRAP_ADMIN_PASSWORD"
      ],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.env"]
    },
    "dev:debug": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.*"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {},
    "test:integration": {
      "cache": false
    },
    "//#infra:up": {
      "cache": false
    },
    "//#infra:down": {
      "cache": false
    }
  }
}
